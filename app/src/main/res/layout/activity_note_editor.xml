<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D8DDE6">

    <!-- Main Editor Screen Container -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top Header Navigation Bar -->
        <LinearLayout
            android:id="@+id/editor_top_bar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/bg_surface"
            android:elevation="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_revert" />

            <TextView
                android:id="@+id/tv_editor_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:maxWidth="200dp"
                android:singleLine="true"
                android:text="My Notebook"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Page Navigation Controls -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:background="@drawable/bg_floating_dock"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="6dp">

                <Button
                    android:id="@+id/btn_prev_page"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:text="&lt;"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tv_page_indicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:text="Page 1 of 1"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_next_page"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:text="&gt;"
                    android:textSize="14sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_add_page"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:text="+ Page"
                android:textColor="@color/primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <!-- Undo / Redo -->
            <Button
                android:id="@+id/btn_undo"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="44dp"
                android:layout_height="36dp"
                android:text="↶"
                android:textSize="18sp" />

            <Button
                android:id="@+id/btn_redo"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="44dp"
                android:layout_height="36dp"
                android:text="↷"
                android:textSize="18sp" />

            <!-- Paper Template Changer -->
            <Button
                android:id="@+id/btn_change_template"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="📐 Paper"
                android:textSize="12sp" />

            <!-- Flashcard Study Mode Button -->
            <Button
                android:id="@+id/btn_flashcards"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="🎴 Cards"
                android:textColor="@color/accent"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Export PDF -->
            <Button
                android:id="@+id/btn_export_pdf"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Export PDF"
                android:textSize="12sp" />

            <!-- On-Device AI Sparkle Button -->
            <Button
                android:id="@+id/btn_open_ai"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="@color/accent"
                android:text="✨ Study AI"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Canvas Area Scroll / Viewport -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/editor_top_bar"
            android:fillViewport="true">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fillViewport="true">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:padding="30dp">

                    <com.flownotes.app.view.CanvasView
                        android:id="@+id/canvas_view"
                        android:layout_width="850dp"
                        android:layout_height="1150dp"
                        android:background="@android:color/white"
                        android:elevation="8dp" />
                </FrameLayout>
            </HorizontalScrollView>
        </ScrollView>

        <!-- Floating Pen Dock Toolbar (Freenotes Style) -->
        <LinearLayout
            android:id="@+id/floating_pen_dock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/editor_top_bar"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_floating_dock"
            android:elevation="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp">

            <Button
                android:id="@+id/tool_ballpoint"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="48dp"
                android:layout_height="38dp"
                android:text="🖊️ Pen"
                android:textSize="11sp" />

            <Button
                android:id="@+id/tool_fountain"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="48dp"
                android:layout_height="38dp"
                android:text="✒️ Ink"
                android:textSize="11sp" />

            <Button
                android:id="@+id/tool_highlighter"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="52dp"
                android:layout_height="38dp"
                android:text="🖍️ Glow"
                android:textSize="11sp" />

            <Button
                android:id="@+id/tool_eraser"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="50dp"
                android:layout_height="38dp"
                android:text="🧹 Erase"
                android:textSize="11sp" />

            <!-- Active Recall Tape Tool (Signature Freenotes Feature) -->
            <Button
                android:id="@+id/tool_tape"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="50dp"
                android:layout_height="38dp"
                android:text="🩹 Tape"
                android:textColor="#D97706"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/tool_shape"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="50dp"
                android:layout_height="38dp"
                android:text="📐 Snap"
                android:textSize="11sp" />

            <View
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@color/border_color" />

            <!-- Tape Bulk Reveal / Conceal Quick Buttons -->
            <Button
                android:id="@+id/btn_reveal_tapes"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="32dp"
                android:layout_height="34dp"
                android:text="👁️"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_conceal_tapes"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="32dp"
                android:layout_height="34dp"
                android:text="🙈"
                android:textSize="14sp" />

            <View
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@color/border_color" />

            <!-- Color Palette Preset Chips -->
            <View
                android:id="@+id/color_black"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_floating_dock"
                android:backgroundTint="#1E293B" />

            <View
                android:id="@+id/color_blue"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_floating_dock"
                android:backgroundTint="#3B82F6" />

            <View
                android:id="@+id/color_purple"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_floating_dock"
                android:backgroundTint="#8B5CF6" />

            <View
                android:id="@+id/color_green"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_floating_dock"
                android:backgroundTint="#10B981" />

            <View
                android:id="@+id/color_orange"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_floating_dock"
                android:backgroundTint="#F59E0B" />

            <View
                android:id="@+id/color_red"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_floating_dock"
                android:backgroundTint="#EF4444" />

            <View
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:layout_marginEnd="4dp"
                android:background="@color/border_color" />

            <!-- Stroke Width Presets -->
            <Button
                android:id="@+id/size_fine"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="32dp"
                android:layout_height="34dp"
                android:text="S"
                android:textSize="11sp" />

            <Button
                android:id="@+id/size_medium"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="32dp"
                android:layout_height="34dp"
                android:text="M"
                android:textSize="11sp" />

            <Button
                android:id="@+id/size_bold"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="32dp"
                android:layout_height="34dp"
                android:text="L"
                android:textSize="11sp" />
        </LinearLayout>
    </RelativeLayout>

    <!-- On-Device AI Study Assistant Drawer (Zero Cost, No Server) -->
    <LinearLayout
        android:layout_width="340dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/bg_surface"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🤖 On-Device Study Assistant"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="100% Offline • Zero Server Cost • Private"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_ai_summarize"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:backgroundTint="@color/primary"
                android:text="📝 Summarize"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_ai_gen_cards"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:backgroundTint="@color/accent"
                android:text="🎴 Flashcards"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_ai_problem_solver"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:text="💡 Step-by-Step Problem Solver"
            android:textSize="12sp" />

        <!-- AI Output Display -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:layout_weight="1"
            android:background="@drawable/bg_floating_dock"
            android:padding="12dp">

            <TextView
                android:id="@+id/tv_ai_output"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tap 'Summarize' or 'Flashcards' above, or type a question below to analyze your notes instantly on-device."
                android:textColor="@color/text_primary"
                android:textSize="13sp" />
        </ScrollView>

        <Button
            android:id="@+id/btn_insert_ai_note"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:text="➕ Insert Summary into Note"
            android:textColor="@color/primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Chat Input Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/et_ai_question"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_floating_dock"
                android:hint="Ask about this note..."
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_ai_ask"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:backgroundTint="@color/primary"
                android:text="Ask"
                android:textColor="@android:color/white"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
