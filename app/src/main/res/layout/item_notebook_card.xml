<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardCornerRadius="18dp"
    app:cardElevation="3dp"
    app:strokeWidth="1dp"
    app:strokeColor="?attr/flownotesBorder"
    app:cardBackgroundColor="?attr/flownotesSurfaceCard">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Notebook Cover Aspect Container (148dp height) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="148dp">

            <!-- Notebook Cover View -->
            <View
                android:id="@+id/view_card_cover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_card_cover" />

            <!-- Authentic Bookbinding Spine Strip (Left 14dp) -->
            <View
                android:layout_width="14dp"
                android:layout_height="match_parent"
                android:background="?attr/flownotesSpineOverlay" />

            <!-- Spine Crease Highlight Line (1.5dp) -->
            <View
                android:layout_width="1.5dp"
                android:layout_height="match_parent"
                android:layout_marginStart="14dp"
                android:background="#20FFFFFF" />

            <!-- Favorite Star Badge (Top-Left overlay) -->
            <ImageView
                android:id="@+id/iv_favorite_star"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="top|start"
                android:layout_marginStart="20dp"
                android:layout_marginTop="10dp"
                android:src="@drawable/ic_bookmark"
                app:tint="#FEF08A"
                android:visibility="gone"
                android:contentDescription="Favorite Note" />

            <!-- Page Count Badge (Top-Right pill overlay) -->
            <TextView
                android:id="@+id/tv_cover_page_badge"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="10dp"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:background="@drawable/bg_badge_pill"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="4 pgs" />

            <!-- Notebook Title Preview on Cover -->
            <TextView
                android:id="@+id/tv_cover_badge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="16dp"
                android:gravity="center"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="3"
                android:ellipsize="end"
                android:shadowColor="#90000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="4"
                tools:text="Calculus II Notes" />
        </FrameLayout>

        <!-- Notebook Metadata Footer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            android:paddingTop="10dp"
            android:paddingBottom="12dp">

            <!-- Title & 3-Dot Menu Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_card_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="?attr/flownotesTextPrimary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="Calculus II Notes" />

                <!-- 3-Dot Popup Action Menu -->
                <ImageView
                    android:id="@+id/btn_card_menu"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:padding="6dp"
                    android:src="@drawable/ic_more_vert"
                    app:tint="?attr/flownotesTextSecondary"
                    android:contentDescription="Notebook Options" />
            </LinearLayout>

            <!-- Metadata Subtitle: Page count & Last updated -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">

                <TextView
                    android:id="@+id/tv_card_folder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/flownotesTextSecondary"
                    android:textSize="11sp"
                    tools:text="Study • " />

                <TextView
                    android:id="@+id/tv_card_updated"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/flownotesTextSecondary"
                    android:textSize="11sp"
                    tools:text="Updated 2h ago" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
